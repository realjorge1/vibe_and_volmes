# ─── Vibe & Volumes backend env ───────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit a real key — .env is gitignored.

# HTTP port the server listens on (Render injects its own PORT in prod).
PORT=8787

# Comma-separated allowed CORS origins, or * for any.
# Native app fetches send no Origin, so * is fine for mobile; tighten for web.
ALLOWED_ORIGINS=*

# ─── AI proxy ──────────────────────────────────────────────────────────────
# The LLM key lives ONLY here, never in the mobile bundle. Leave blank to make
# /ai/generate return 503 (the client then stays on free local generation).
AI_API_KEY=
# OpenAI-compatible chat-completions endpoint. Point at any compatible host.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Per-request output ceiling (mirrors the client AI_CONFIG.maxOutputTokens).
MAX_OUTPUT_TOKENS=380
# Network timeout for the upstream LLM call, ms.
LLM_TIMEOUT_MS=9000
# Server-side daily token guardrail (defense in depth on top of client budget).
MAX_TOKENS_PER_DAY=2000000

# ─── Community sync ────────────────────────────────────────────────────────
# When false, /community/* still responds but the client treats community as
# off and uses bundled local data. Gameplay never depends on these endpoints.
COMMUNITY_ENABLED=true
